# Innovatiepijplijn — Omgevingsvariabelen
# Kopieer dit bestand naar .env en pas de waarden aan.

# ====================================================================
# Applicatie
# ====================================================================

# Poort waarop de webapplicatie bereikbaar is op je hostmachine
APP_PORT=8000

# Host adres binnen de container (meestal niet aanpassen)
APP_HOST=0.0.0.0

# Omgeving: development, staging, production
APP_ENV=development

# Basis-URL van de applicatie (voor links in templates en JavaScript)
# Pas dit aan naar het adres waar de app bereikbaar is in jouw netwerk
# Voorbeelden:
#   Lokaal:          http://localhost:8000
#   Op netwerk:      http://192.168.1.50:8000
#   Achter proxy:    https://innovatiepijplijn.onbedomein.nl
APP_BASE_URL=http://localhost:8000

# ====================================================================
# Database
# ====================================================================

# Pad voor SQLite database (alleen aanpassen bij speciale opslaglocatie)
# DATABASE_PATH=/app/data/innovatiepijplijn.db

# Directory voor backups (standaard: naast de database)
# BACKUP_DIR=/app/data/backups

# ====================================================================
# Admin account (wordt automatisch aangemaakt bij eerste startup)
# ====================================================================

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=verander-dit

# ====================================================================
# AI / Taalmodel configuratie (model-agnostisch)
# ====================================================================

# URL van het taalmodel (base URL zonder /v1/chat/completions)
MODEL_URL=http://beestjeai2.local:8033

# Modelnaam (bijv. qwen3.6, llama3, mistral, etc.)
MODEL_NAME=qwen3.6

# API key (optioneel — veel lokale modellen hebben geen key nodig)
# MODEL_API_KEY=sk-your-key-here

# AI functionaliteit inschakelen/uitschakelen
AI_ENABLED=true

# Timeout per AI-request in seconden (thinking-modellen hebben meer tijd nodig)
AI_REQUEST_TIMEOUT=600

# ====================================================================
# Logging
# ====================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: console (leesbaar) of json (voor log-aggregators)
LOG_FORMAT=console
